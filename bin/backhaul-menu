select_backup_archive() {
    local result_variable="$1"
    local -a archives=() choices=()
    local archive choice="" index
    if [[ -d "$BH_BACKUP_DIR" ]]; then
        mapfile -t archives < <(
            find "$BH_BACKUP_DIR" -maxdepth 1 -type f \
                -name 'backhaul-backup-*.tar.gz' -printf '%T@ %p\n' |
                sort -rn | cut -d' ' -f2-
        )
    fi
    ((${#archives[@]} > 0)) || {
        warn "No backup archive is available."
        return 1
    }
    for index in "${!archives[@]}"; do
        archive="${archives[$index]}"
        choices+=("$((index + 1))|$(basename "$archive")")
    done
    choices+=("0|Back")
    menu_select choice "Select a backup" "${choices[@]}" || return 1
    [[ "$choice" != "0" ]] || return 1
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    ((choice >= 1 && choice <= ${#archives[@]})) || return 1
    printf -v "$result_variable" '%s' "${archives[$((choice - 1))]}"
}

backup_menu() {
    local choice="" archive="" restore_word=""
    while true; do
        clear_screen
        printf '%sBackups and restore%s\n\n' "$BH_CYAN" "$BH_RESET"
        menu_select choice "Selection" \
            "1|Create a new backup" \
            "2|List backups" \
            "3|Restore a backup" \
            "0|Back" || return 0
        case "$choice" in
            1) capture_and_page "Backup result" "$BH_MANAGER_BIN" backup create || true ;;
            2) capture_and_page "Available backups" "$BH_MANAGER_BIN" backup list || true ;;
            3)
                select_backup_archive archive || continue
                printf 'Restore replaces matching configs and service files.\n'
                printf 'A safety backup and automatic rollback are enabled.\n'
                read -r -p "Type RESTORE to continue: " restore_word || continue
                [[ "$restore_word" == "RESTORE" ]] || { warn "Restore cancelled."; pause_menu || true; continue; }
                if confirm_twice "Restore $(basename "$archive")?"; then
                    capture_and_page "Restore / rollback result" \
                        "$BH_MANAGER_BIN" backup restore "$archive" --yes || true
                fi
                ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu || true ;;
        esac
    done
}

add_server_interactive() {
    local name="" bind="" public_host="" transport="wsmux" mapping=""
    local -a args=()
    read -r -p "Short country name (example: de): " name || return 0
    read -r -p "Control bind address (example: 0.0.0.0:9200): " bind ||
        return 0
    read -r -p "Public IP or domain of the Iran server: " public_host ||
        return 0
    read -r -p "Transport [wsmux]: " transport || return 0
    transport="${transport:-wsmux}"
    while true; do
        read -r -p "Port mapping (example: 8200=127.0.0.1:8090; press Enter to finish): " mapping ||
            return 0
        [[ -n "$mapping" ]] || break
        args+=(--map "$mapping")
    done
    ((${#args[@]} > 0)) || {
        warn "No port mapping was entered."
        return 0
    }
    confirm "Create a server tunnel named $name?" || return 0
    "$BH_MANAGER_BIN" server add \
        --name "$name" \
        --bind "$bind" \
        --public-host "$public_host" \
        --transport "$transport" \
        "${args[@]}"
}

add_client_interactive() {
    local name="" remote="" transport="wsmux" token=""
    read -r -p "Short country name (must match the server name): " name ||
        return 0
    read -r -p "Iran control address (HOST:PORT): " remote || return 0
    read -r -p "Transport [wsmux]: " transport || return 0
    transport="${transport:-wsmux}"
    read -r -s -p "Server token: " token || return 0
    printf '\n'
    confirm "Create a client tunnel named $name?" || return 0
    "$BH_MANAGER_BIN" client add \
        --name "$name" \
        --remote "$remote" \
        --transport "$transport" \
        --token "$token"
}

configure_tunnel() {
    local choice=""
    while true; do
        clear_screen
        printf '%sCreate a new tunnel%s\n\n' "$BH_CYAN" "$BH_RESET"
        menu_select choice "Selection" \
            "1|${BH_GREEN}Configure the Iran entry server (Server)${BH_RESET}" \
            "2|${BH_CYAN}Configure a foreign exit server (Client)${BH_RESET}" \
            "0|Back" || return 0
        case "$choice" in
            1) add_server_interactive; pause_menu || true ;;
            2) add_client_interactive; pause_menu || true ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu || true ;;
        esac
    done
}

show_listening_summary() {
    local rows
    command -v ss >/dev/null 2>&1 || { warn "The ss command is not installed."; return 1; }
    rows="$(ss -Hlntp 2>/dev/null | grep -F 'backhaul' || true)"
    if [[ -z "$rows" ]]; then
        printf 'Listening port: none\n'
        printf 'Client note: a Client normally has no Backhaul listening port.\n'
        return 0
    fi
    printf '%s\n' "$rows" | awk '{
        process="backhaul"; local_addr=$4
        print "Local: " local_addr
        print "State: Listening"
        print "Process: " process "\n"
    }'
}

show_connection_summary() {
    local rows
    command -v ss >/dev/null 2>&1 || { warn "The ss command is not installed."; return 1; }
    rows="$(ss -Hntp 2>/dev/null | grep -F 'backhaul' || true)"
    if [[ -z "$rows" ]]; then
        printf 'State: Disconnected\nActive connections: 0\nProcess: backhaul\n'
        return 0
    fi
    printf '%s\n' "$rows" | awk '
        { count[$5]++; state[$5]=$1 }
        END {
            for (remote in count) {
                print "Remote: " remote
                print "State: " (state[remote] == "ESTAB" ? "Connected" : state[remote])
                print "Active connections: " count[remote]
                print "Process: backhaul\n"
            }
        }'
}

socket_totals_for_pid() {
    local pid="$1"
    command -v ss >/dev/null 2>&1 || { printf '0 0\n'; return; }
    ss -Htinp 2>/dev/null | awk -v wanted="pid=$pid," '
        index($0, wanted) { matched=1; next }
        matched {
            sent=received=0
            if (match($0, /bytes_acked:[0-9]+/)) {
                sent=substr($0, RSTART, RLENGTH); sub(/^bytes_acked:/, "", sent)
            }
            if (match($0, /bytes_received:[0-9]+/)) {
                received=substr($0, RSTART, RLENGTH); sub(/^bytes_received:/, "", received)
            }
            tx+=sent; rx+=received; matched=0
        }
        END { printf "%.0f %.0f\n", rx, tx }'
}

configured_ports() {
    local config="$1"
    [[ -r "$config" ]] || return 0
    sed -nE '
        s/^[[:space:]]*(bind_addr|remote_addr)[[:space:]]*=[[:space:]]*".*:([0-9]+)".*/\2/p
        s/^[[:space:]]*"?([0-9]+)=.*/\1/p
    ' "$config" | sort -nu
}

port_monitor_snapshot() {
    local unit="$1" previous_rx="$2" previous_tx="$3" elapsed="$4" base_rx="$5" base_tx="$6"
    local pid role config endpoint current_rx current_tx down up connections port port_connections
    local ingress egress
    pid="$(systemd_property "$unit" MainPID)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || pid=0
    config="$(unit_config_path "$unit" 2>/dev/null || true)"
    role="$(unit_role_from_config "$config")"
    endpoint="$(config_endpoint "$unit")"
    read -r current_rx current_tx < <(socket_totals_for_pid "$pid")
    [[ "$elapsed" =~ ^[1-9][0-9]*$ ]] || elapsed=1
    down=$(( current_rx >= previous_rx ? (current_rx - previous_rx) / elapsed : 0 ))
    up=$(( current_tx >= previous_tx ? (current_tx - previous_tx) / elapsed : 0 ))
    connections="$(active_connection_count "$pid")"

    printf '\033[2KPort Monitor: %s\n' "$unit"
    printf '\033[2KRole: %s | PID: %s | Process: backhaul\n' "$role" "$pid"
    printf '\033[2KEndpoint: %s\n' "$endpoint"
    if [[ "$role" == "server" ]]; then
        if ss -Hlntp 2>/dev/null | grep -Fq "pid=$pid,"; then
            printf '\033[2KLocal listener: OPEN\n'
        else
            printf '\033[2K[ALERT] Local listener is DOWN\n'
        fi
    else
        printf '\033[2KLocal listener: N/A (Client)\n'
    fi
    if [[ "$connections" =~ ^[0-9]+$ ]] && ((connections > 0)); then
        printf '\033[2KRemote connection: CONNECTED\n'
    else
        printf '\033[2K[ALERT] Remote connection is DOWN\n'
    fi
    printf '\033[2KActive connections: %s\n' "$connections"
    while IFS= read -r port; do
        [[ -n "$port" ]] || continue
        port_connections="$(ss -Hntp 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" || $5 ~ p"$" {n++} END {print n+0}')"
        if ss -Hlntp 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {found=1} END {exit !found}'; then
            printf '\033[2KPort %s: OPEN | Process: backhaul | Connections: %s\n' "$port" "$port_connections"
        elif [[ "$role" == "client" && "$port" == "${endpoint##*:}" ]]; then
            printf '\033[2KPort %s: REMOTE | Process: backhaul | Connections: %s\n' "$port" "$port_connections"
        else
            printf '\033[2KPort %s: CLOSED | Process: none | Connections: %s\n' "$port" "$port_connections"
        fi
    done < <(configured_ports "$config")
    printf '\033[2KDownload: %s/s | Upload: %s/s\n' \
        "$(human_bytes "$down")" "$(human_bytes "$up")"
    ingress="$(systemd_property "$unit" IPIngressBytes)"
    egress="$(systemd_property "$unit" IPEgressBytes)"
    [[ "$ingress" =~ ^[0-9]+$ ]] || ingress="$current_rx"
    [[ "$egress" =~ ^[0-9]+$ ]] || egress="$current_tx"
    printf '\033[2KTotal received/sent: %s / %s\n' "$(human_bytes "$ingress")" "$(human_bytes "$egress")"
    printf '\033[2KToday observed: %s / %s\n' \
        "$(human_bytes "$((current_rx >= base_rx ? current_rx - base_rx : 0))")" \
        "$(human_bytes "$((current_tx >= base_tx ? current_tx - base_tx : 0))")"
    printf '\033[2KSince service start: %s / %s\n' "$(human_bytes "$ingress")" "$(human_bytes "$egress")"
    printf '\033[2KPress R to refresh now or Q to return.\n'
    printf '%s %s\n' "$current_rx" "$current_tx"
}

port_monitor() {
    local unit="$1" pid rx=0 tx=0 base_rx=0 base_tx=0 new_rx=0 new_tx=0 key="" snapshot
    pid="$(systemd_property "$unit" MainPID)"
    read -r rx tx < <(socket_totals_for_pid "${pid:-0}")
    base_rx="$rx"
    base_tx="$tx"
    clear_screen
    while true; do
        # Refresh the existing frame in place; do not clear the full screen on
        # every sample because mobile terminals visibly flash on rapid clears.
        printf '\033[H'
        snapshot="$(port_monitor_snapshot "$unit" "$rx" "$tx" 1 "$base_rx" "$base_tx")"
        new_rx="$(printf '%s\n' "$snapshot" | tail -n1 | awk '{print $1}')"
        new_tx="$(printf '%s\n' "$snapshot" | tail -n1 | awk '{print $2}')"
        printf '%s\n' "$(printf '%s\n' "$snapshot" | sed '$d')"
        printf '\033[J'
        key=""
        IFS= read -rsN1 -t 1 key || true
        case "$key" in q|Q|$'\e') return 0 ;; esac
        rx="${new_rx:-$rx}"
        tx="${new_tx:-$tx}"
    done
}

network_tools() {
    local choice="" settings_file
    while true; do
        clear_screen
        printf '%sNetwork diagnostics%s\n\n' "$BH_CYAN" "$BH_RESET"
        menu_select choice "Selection" \
            "1|Run full Backhaul diagnostics" \
            "2|Show listening ports (summary)" \
            "3|Show active connections (summary)" \
            "4|Show important network settings (read-only)" \
            "0|Back" || return 0
        case "$choice" in
            1) capture_and_page "Backhaul diagnostics" "$BH_MANAGER_BIN" doctor || true ;;
            2) capture_and_page "Listening ports" show_listening_summary || true ;;
            3) capture_and_page "Active connections" show_connection_summary || true ;;
            4)
                settings_file="$(mktemp)"
                {
                    printf 'qdisc: '; sysctl -n net.core.default_qdisc 2>/dev/null || printf 'unknown\n'
                    printf 'congestion_control: '; sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || printf 'unknown\n'
                    printf 'rmem_max: '; sysctl -n net.core.rmem_max 2>/dev/null || printf 'unknown\n'
                    printf 'wmem_max: '; sysctl -n net.core.wmem_max 2>/dev/null || printf 'unknown\n'
                    printf '\nRead-only: no setting was changed.\n'
                } >"$settings_file"
                show_file_paged "Network settings" "$settings_file"
                rm -f -- "$settings_file"
                ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu || true ;;
        esac
    done
}

core_menu() {
    local choice=""
    while true; do
        clear_screen
        printf '%sBackhaul core%s\n\n' "$BH_CYAN" "$BH_RESET"
        menu_select choice "Selection" \
            "1|Show core version and hash" \
            "2|Install or update the official Backhaul core" \
            "0|Back" || return 0
        case "$choice" in
            1)
                if [[ -x "$BH_BIN" ]]; then
                    "$BH_BIN" --version 2>/dev/null || true
                    sha256sum "$BH_BIN"
                else
                    warn "The Backhaul core is not installed."
                fi
                pause_menu || true
                ;;
            2) update_backhaul; pause_menu || true ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu || true ;;
        esac
    done
}

update_backhaul() {
    local latest=""
    local version=""
    if latest="$(latest_backhaul_version)"; then
        version="$latest"
        printf 'Latest official Backhaul release: %s\n' "$latest"
    else
        version="$BH_VERSION_DEFAULT"
        warn "Could not query GitHub; using the tested fallback $BH_VERSION_DEFAULT."
    fi
    read -r -p "Backhaul version [$version] (or type latest): " version ||
        return 0
    version="${version:-${latest:-$BH_VERSION_DEFAULT}}"
    printf 'This operation verifies the release digest, backs up the current binary,\n'
    printf 'restarts active Backhaul services, and rolls back if they do not remain healthy.\n'
    confirm "Update the Backhaul core to $version?" || return 0
    if [[ "$version" == "latest" ]]; then
        "$BH_MANAGER_BIN" binary install --latest
    else
        "$BH_MANAGER_BIN" binary install --version "$version"
    fi
}

update_manager() {
    local temp_dir installer
    confirm "Update Manager files from GitHub?" || return 0
    if ! command -v curl >/dev/null 2>&1 &&
       ! command -v wget >/dev/null 2>&1; then
        warn "curl or wget is required to update the Manager."
        return 1
    fi
    temp_dir="$(mktemp -d)"
    installer="$temp_dir/install.sh"
    if ! download_to "$BH_RAW_BASE/install.sh" "$installer"; then
        rm -rf -- "$temp_dir"
        warn "Failed to download the Manager installer."
        return 1
    fi
    chmod 755 "$installer"
    if ! BH_RAW_BASE="$BH_RAW_BASE" "$installer" --skip-binary; then
        rm -rf -- "$temp_dir"
        warn "The Manager update failed. Existing tunnel configs were not changed."
        return 1
    fi
    rm -rf -- "$temp_dir"
    success "Manager updated. Configs and services were left unchanged."
}

main_menu() {
    require_root
    trap handle_exit EXIT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    terminal_enter

    while true; do
        header
        local choice=""
        menu_select choice "Select an option" \
            "1|${BH_GREEN}Create a new tunnel (IPv4 / IPv6)${BH_RESET}" \
            "2|${BH_YELLOW}Manage tunnels${BH_RESET}" \
            "3|${BH_CYAN}Show all tunnel statuses${BH_RESET}" \
            "4|Health check and auto-repair" \
            "5|Manage health-check cron" \
            "6|Backups and restore" \
            "7|Network diagnostics" \
            "8|Install or update the Backhaul core" \
            "9|Update Manager from GitHub" \
            "0|Exit" || return 0
        case "$choice" in
            1) configure_tunnel ;;
            2) tunnel_management ;;
            3) show_dashboard; pause_menu ;;
            4) health_menu ;;
            5) cron_menu ;;
            6) backup_menu ;;
            7) network_tools ;;
            8) core_menu ;;
            9) update_manager; pause_menu ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu ;;
        esac
    done
}

main_menu "$@"
