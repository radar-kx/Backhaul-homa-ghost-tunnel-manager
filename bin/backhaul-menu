#!/usr/bin/env bash
# An interactive menu must handle individual command failures without exiting.
set -Euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r "${BH_PROJECT_DIR:-/opt/backhaul-tunnel-manager}/lib/common.sh" ]]; then
    # shellcheck source=/opt/backhaul-tunnel-manager/lib/common.sh
    # shellcheck disable=SC1091
    source "${BH_PROJECT_DIR:-/opt/backhaul-tunnel-manager}/lib/common.sh"
else
    # shellcheck source=../lib/common.sh
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/../lib/common.sh"
fi

BH_ALTERNATE_SCREEN_ACTIVE=0
BH_TERMINAL_RESTORED=0
BH_STTY_ACTIVE=0
BH_STTY_SAVED=""
BH_TERM_ROWS=0
BH_TERM_COLUMNS=0

is_terminal() {
    [[ (-t 0 && (-t 1 || -t 2)) || "${BH_FORCE_TTY:-0}" == "1" ]]
}

terminal_row_count() {
    local rows="${BH_TERM_ROWS_OVERRIDE:-}"
    if [[ ! "$rows" =~ ^[0-9]+$ ]] ||
       ((rows < 12 || rows > 500)); then
        if command -v tput >/dev/null 2>&1 &&
           [[ "${TERM:-dumb}" != "dumb" ]]; then
            rows="$(tput lines 2>/dev/null || true)"
        fi
    fi
    if [[ ! "$rows" =~ ^[0-9]+$ ]] ||
       ((rows < 12 || rows > 500)); then
        rows="${LINES:-}"
    fi
    if [[ ! "$rows" =~ ^[0-9]+$ ]] ||
       ((rows < 12 || rows > 500)); then
        rows=24
    fi
    printf '%s\n' "$rows"
}

terminal_column_count() {
    local columns="${BH_TERM_COLUMNS_OVERRIDE:-}"
    if [[ ! "$columns" =~ ^[0-9]+$ ]] ||
       ((columns < 20 || columns > 500)); then
        if command -v tput >/dev/null 2>&1 &&
           [[ "${TERM:-dumb}" != "dumb" ]]; then
            columns="$(tput cols 2>/dev/null || true)"
        fi
    fi
    if [[ ! "$columns" =~ ^[0-9]+$ ]] ||
       ((columns < 20 || columns > 500)); then
        columns="${COLUMNS:-}"
    fi
    if [[ ! "$columns" =~ ^[0-9]+$ ]] ||
       ((columns < 20 || columns > 500)); then
        columns=80
    fi
    printf '%s\n' "$columns"
}

strip_menu_colors() {
    local text="$1"
    local color
    for color in "$BH_RED" "$BH_GREEN" "$BH_YELLOW" "$BH_BLUE" "$BH_CYAN" "$BH_RESET"; do
        [[ -n "$color" ]] || continue
        text="${text//$color/}"
    done
    printf '%s' "$text"
}

fit_menu_text() {
    local text
    text="$(strip_menu_colors "$1")"
    local maximum="$2"
    ((maximum > 0)) || return 0
    if ((${#text} <= maximum)); then
        printf '%s' "$text"
    elif ((maximum <= 3)); then
        printf '%s' "${text:0:maximum}"
    else
        printf '%s...' "${text:0:maximum-3}"
    fi
}

terminal_cursor_row() {
    local result_variable="$1"
    local override="${BH_TERM_CURSOR_ROW_OVERRIDE:-}"
    local response="" position="" row="" column=""

    if [[ "$override" =~ ^[0-9]+$ ]] &&
       ((override >= 1 && override <= BH_TERM_ROWS)); then
        printf -v "$result_variable" '%s' "$override"
        return 0
    fi

    [[ -t 0 ]] || return 1
    terminal_input_begin || return 1

    # Ask the terminal for its current cursor position. The response has the
    # form ESC[row;columnR and is read while echo is disabled, so it never
    # appears as text in the menu.
    if [[ -t 2 ]]; then
        printf '\033[6n' >&2
    elif [[ -t 1 ]]; then
        printf '\033[6n'
    else
        terminal_input_end
        return 1
    fi
    IFS= read -r -s -d R -t "${BH_CURSOR_QUERY_TIMEOUT:-0.8}" response || true
    terminal_input_end

    [[ "$response" == *$'\033['*';'* ]] || return 1
    position="${response##*$'\033['}"
    row="${position%%;*}"
    column="${position#*;}"
    [[ "$row" =~ ^[0-9]+$ && "$column" =~ ^[0-9]+$ ]] || return 1
    ((row >= 1 && row <= BH_TERM_ROWS)) || return 1
    printf -v "$result_variable" '%s' "$row"
}

scroll_visible_prefix_to_history() {
    local cursor_row="$1"
    local row_index scroll_count

    [[ "$cursor_row" =~ ^[0-9]+$ ]] || return 1
    ((cursor_row >= 1 && cursor_row <= BH_TERM_ROWS)) || return 1
    scroll_count=$((cursor_row - 1))

    # Only the rows actually used before the cursor are moved to scrollback.
    # Moving a full terminal height would add an artificial blank page between
    # the old shell output and the prompt shown after leaving `bh`.
    if ((scroll_count > 0)); then
        printf '\033[%d;1H' "$BH_TERM_ROWS"
        for ((row_index = 0; row_index < scroll_count; row_index++)); do
            printf '\r\n'
        done
    fi
    printf '\033[H'
}

archive_current_view() {
    local cursor_row=""

    is_terminal || return 0
    [[ "${TERM:-dumb}" != "dumb" ]] || return 0
    BH_TERM_ROWS="$(terminal_row_count)"
    terminal_cursor_row cursor_row || return 1
    scroll_visible_prefix_to_history "$cursor_row"
}

terminal_enter() {
    is_terminal || return 0
    [[ "${TERM:-dumb}" != "dumb" ]] || return 0

    BH_TERM_ROWS="$(terminal_row_count)"
    BH_TERM_COLUMNS="$(terminal_column_count)"
    # The entire interface lives in the alternate buffer. Returning from homa
    # restores the user's shell exactly as it was before the menu opened.
    printf '\033[?1049h\033[2J\033[H'
    BH_ALTERNATE_SCREEN_ACTIVE=1
}

terminal_leave() {
    ((BH_TERMINAL_RESTORED == 0)) || return 0
    BH_TERMINAL_RESTORED=1
    terminal_input_end
    printf '%s' "$BH_RESET"

    if ((BH_ALTERNATE_SCREEN_ACTIVE == 1)) && is_terminal; then
        printf '\033[2J\033[H\033[?1049l'
        BH_ALTERNATE_SCREEN_ACTIVE=0
    fi
}

handle_exit() {
    local status=$?
    trap - EXIT HUP TERM
    terminal_leave
    return "$status"
}

pause_menu() {
    printf '\n'
    read -r -p "Press Enter to continue..." _ || return 1

    # Operation/status pages are temporary UI views. Do not push them into
    # the normal buffer's scrollback when returning to a menu; Termius would
    # otherwise show every previous status and backup page above the current
    # HOMA frame. The shell history from before `bh` remains untouched.
    if ((BH_ALTERNATE_SCREEN_ACTIVE == 1)) && is_terminal; then
        clear_screen
    fi
}

clear_screen() {
    if is_terminal || [[ "${BH_FORCE_CLEAR:-0}" == "1" ]]; then
        # Clear only the visible viewport. CSI 3 J is intentionally forbidden:
        # it destroys the history the user expects to reach by touch scrolling.
        printf '\033[2J\033[H'
    fi
}

finish_menu_frame() {
    # A full-height menu can place its prompt on the terminal's last row.
    # Printing a newline after Enter would then scroll the HOMA header into the
    # normal buffer's history. Erase the current menu in place before its
    # caller prints a submenu or command output. Write the control sequence to
    # stderr because select_unit is used inside command substitution.
    if ((BH_ALTERNATE_SCREEN_ACTIVE == 1)) && is_terminal; then
        printf '\033[2J\033[H' >&2
    else
        printf '\n' >&2
    fi
}

terminal_input_begin() {
    [[ -t 0 ]] || return 1
    command -v stty >/dev/null 2>&1 || return 1
    ((BH_STTY_ACTIVE == 0)) || return 0

    BH_STTY_SAVED="$(stty -g <&0 2>/dev/null)" || {
        BH_STTY_SAVED=""
        return 1
    }
    if ! stty -echo -icanon min 1 time 0 <&0 2>/dev/null; then
        BH_STTY_SAVED=""
        return 1
    fi
    BH_STTY_ACTIVE=1
}

terminal_input_end() {
    ((BH_STTY_ACTIVE == 1)) || return 0
    if [[ -n "$BH_STTY_SAVED" ]]; then
        stty "$BH_STTY_SAVED" <&0 2>/dev/null || true
    fi
    BH_STTY_ACTIVE=0
    BH_STTY_SAVED=""
}

menu_has_key_navigation() {
    is_terminal &&
        [[ "${TERM:-dumb}" != "dumb" ]] &&
        [[ "${BH_DISABLE_KEY_NAVIGATION:-0}" != "1" ]] &&
        command -v stty >/dev/null 2>&1
}

menu_value_exists() {
    local wanted="$1"
    shift
    local entry
    for entry in "$@"; do
        [[ "${entry%%|*}" == "$wanted" ]] && return 0
    done
    return 1
}

render_menu_choice_line() {
    local selected="$1"
    local entry="$2"
    local columns="${BH_TERM_COLUMNS:-80}"
    local label_width=$((columns - 7))
    local value label fitted_label
    ((label_width >= 4)) || label_width=4

    value="${entry%%|*}"
    label="${entry#*|}"
    fitted_label="$(fit_menu_text "$label" "$label_width")"

    if ((selected == 1)); then
        printf '\r\033[2K%s> %s) %s%s' \
            "$BH_CYAN" "$value" "$fitted_label" "$BH_RESET" >&2
    else
        printf '\r\033[2K  %s) %s' "$value" "$fitted_label" >&2
    fi
}

render_menu_prompt() {
    local typed_number="$1"
    local prompt="$2"
    local columns="${BH_TERM_COLUMNS:-80}"
    local prompt_text=""

    if ((columns < 58)); then
        prompt_text="Choice:"
    else
        prompt_text="$(fit_menu_text "$prompt" $((columns - 39)))"
        prompt_text+=": [Up/Down + Enter or number]"
    fi
    prompt_text="$(fit_menu_text "$prompt_text" $((columns - 2 - ${#typed_number})))"
    printf '\r\033[2K%s %s' "$prompt_text" "$typed_number" >&2
}

render_menu_choices() {
    local selected_index="$1"
    local typed_number="$2"
    local prompt="$3"
    shift 3

    local entry index=0
    for entry in "$@"; do
        if ((index == selected_index)); then
            render_menu_choice_line 1 "$entry"
        else
            render_menu_choice_line 0 "$entry"
        fi
        printf '\n' >&2
        index=$((index + 1))
    done
    render_menu_prompt "$typed_number" "$prompt"
}

redraw_menu_choice_at() {
    local index="$1"
    local selected="$2"
    local entry_count="$3"
    local entry="$4"
    local offset=$((entry_count - index))

    # The cursor lives on the prompt row. Update only the old and new
    # selection rows, then return to the prompt. Repainting the complete menu
    # for every arrow key caused a visible full-screen flash in Termius.
    printf '\r\033[%dA' "$offset" >&2
    render_menu_choice_line "$selected" "$entry"
    printf '\r\033[%dB' "$offset" >&2
}

menu_select() {
    local result_variable="$1"
    local prompt="$2"
    shift 2
    local -a entries=("$@")
    local selection=""

    ((${#entries[@]} > 0)) || {
        warn "The menu has no selectable items."
        return 1
    }

    if ! menu_has_key_navigation; then
        local entry value label
        for entry in "${entries[@]}"; do
            value="${entry%%|*}"
            label="${entry#*|}"
            printf ' %s) %s\n' "$value" "$label" >&2
        done
        printf '\n%s: ' "$prompt" >&2
        IFS= read -r selection || return 1
        finish_menu_frame
        printf -v "$result_variable" '%s' "$selection"
        return 0
    fi

    local selected_index=0
    local rendered_selected_index=0
    local typed_number=""
    local rendered_typed_number=""
    local key="" sequence="" suffix=""
    local read_status=0
    local escape_index=0
    local entry_count="${#entries[@]}"
    local needs_prompt=0
    terminal_input_begin || return 1
    render_menu_choices "$selected_index" "$typed_number" "$prompt" \
        "${entries[@]}"

    while true; do
        key=""
        # A short quiet window coalesces key-repeat bursts. Only the final
        # selection is painted, avoiding a full redraw for every queued arrow.
        IFS= read -rsN1 -t 0.03 key
        read_status=$?
        if ((read_status > 128)); then
            needs_prompt=0
            if ((selected_index != rendered_selected_index)); then
                redraw_menu_choice_at \
                    "$rendered_selected_index" 0 "$entry_count" \
                    "${entries[$rendered_selected_index]}"
                redraw_menu_choice_at \
                    "$selected_index" 1 "$entry_count" \
                    "${entries[$selected_index]}"
                rendered_selected_index="$selected_index"
                needs_prompt=1
            fi
            if [[ "$typed_number" != "$rendered_typed_number" ]]; then
                rendered_typed_number="$typed_number"
                needs_prompt=1
            fi
            if ((needs_prompt == 1)); then
                render_menu_prompt "$typed_number" "$prompt"
            fi
            continue
        fi
        if ((read_status != 0)); then
            terminal_input_end
            finish_menu_frame
            return 1
        fi

        case "$key" in
            ''|$'\n'|$'\r')
                if [[ -n "$typed_number" ]]; then
                    selection="$typed_number"
                else
                    selection="${entries[$selected_index]%%|*}"
                fi
                break
                ;;
            [0-9])
                typed_number+="$key"
                ;;
            $'\177'|$'\b')
                [[ -n "$typed_number" ]] &&
                    typed_number="${typed_number%?}"
                ;;
            $'\e')
                sequence=""
                suffix=""
                IFS= read -rsN1 -t 0.2 sequence || true
                if [[ "$sequence" == "[" ]]; then
                    for ((escape_index = 0; escape_index < 8; escape_index++)); do
                        suffix=""
                        IFS= read -rsN1 -t 0.2 suffix || true
                        [[ -n "$suffix" ]] || break
                        sequence+="$suffix"
                        [[ "$suffix" == [A-Za-z~] ]] && break
                    done
                elif [[ "$sequence" == "O" ]]; then
                    IFS= read -rsN1 -t 0.2 suffix || true
                    sequence+="$suffix"
                fi
                case "$sequence" in
                    \[*A|'OA')
                        selected_index=$(((selected_index - 1 + entry_count) % entry_count))
                        typed_number=""
                        ;;
                    \[*B|'OB')
                        selected_index=$(((selected_index + 1) % entry_count))
                        typed_number=""
                        ;;
                    \[*H|'OH')
                        selected_index=0
                        typed_number=""
                        ;;
                    \[*F|'OF')
                        selected_index=$((entry_count - 1))
                        typed_number=""
                        ;;
                    '')
                        if menu_value_exists "0" "${entries[@]}"; then
                            selection="0"
                            break
                        fi
                        ;;
                esac
                ;;
        esac

    done

    terminal_input_end
    finish_menu_frame
    printf -v "$result_variable" '%s' "$selection"
    return 0
}

print_homa_logo() {
    printf '%s' "$BH_BLUE"
    cat <<'EOF'
 _   _  ___  __  __    _
| | | |/ _ \|  \/  |  / \
| |_| | | | | |\/| | / _ \
|  _  | |_| | |  | |/ ___ \
|_| |_|\___/|_|  |_/_/   \_\
EOF
    printf '%s' "$BH_RESET"
}

header() {
    local compact_header=0
    local ultra_compact=0

    if is_terminal; then
        BH_TERM_ROWS="$(terminal_row_count)"
        BH_TERM_COLUMNS="$(terminal_column_count)"
    fi
    clear_screen

    # A complete five-line HOMA logo plus the ten-option main menu fits in a
    # 20-row viewport. Keep the brand visible on narrow phones whenever height
    # permits; width alone must never remove the logo. Only genuinely short
    # viewports use a one-line HOMA badge to prevent automatic terminal scroll.
    if ((BH_TERM_ROWS > 0 && BH_TERM_ROWS < 20)); then
        ultra_compact=1
    elif ((BH_TERM_COLUMNS > 0 && BH_TERM_COLUMNS < 72)); then
        compact_header=1
    fi

    if ((ultra_compact == 1)); then
        printf '%s[ HOMA ] HOMA GHOST v%s%s\n' \
            "$BH_CYAN" "$BH_MANAGER_VERSION" "$BH_RESET"
        return 0
    fi

    if ((compact_header == 1)); then
        print_homa_logo
        printf '%sHOMA GHOST TUNNEL MANAGER v%s%s\n' \
            "$BH_CYAN" "$BH_MANAGER_VERSION" "$BH_RESET"
        display_server_info compact
        return 0
    fi

    print_homa_logo
    printf '%sHOMA GHOST TUNNEL MANAGER%s\n' "$BH_CYAN" "$BH_RESET"
    printf '%sManager version: %s%s\n' \
        "$BH_GREEN" "$BH_MANAGER_VERSION" "$BH_RESET"
    printf 'Repository: radar-kx/Backhaul-homa-ghost-tunnel-manager\n'
    display_server_info full
}

display_server_info() {
    local mode="${1:-full}"
    local os_name="unknown"
    local core_version="not-installed"
    local total=0 active=0 unit
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        os_name="$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-unknown}")"
    fi
    if [[ -x "$BH_BIN" ]]; then
        core_version="$("$BH_BIN" --version 2>/dev/null | head -n 1 || true)"
        core_version="${core_version:-installed}"
    fi
    while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue
        total=$((total + 1))
        if command -v systemctl >/dev/null 2>&1 &&
           systemctl is-active --quiet "$unit" >/dev/null 2>&1; then
            active=$((active + 1))
        fi
    done < <(discover_backhaul_units)

    if [[ "$mode" == "compact" ]]; then
        local summary="Tunnels: ${active}/${total} active | Core: ${core_version}"
        printf '%s\n' "$(fit_menu_text "$summary" $((BH_TERM_COLUMNS - 1)))"
        return 0
    fi

    printf '%s==========================================================%s\n' \
        "$BH_YELLOW" "$BH_RESET"
    printf 'Server: %s | System: %s\n' "$(hostname)" "$os_name"
    printf 'Backhaul core: %s\n' "$core_version"
    printf 'Tunnels: %s%d active%s of %d | Health cron: ' \
        "$BH_GREEN" "$active" "$BH_RESET" "$total"
    if [[ -r "$BH_CRON_FILE" ]]; then
        printf '%senabled%s\n' "$BH_GREEN" "$BH_RESET"
    else
        printf '%sdisabled%s\n' "$BH_YELLOW" "$BH_RESET"
    fi
    printf '%s==========================================================%s\n' \
        "$BH_YELLOW" "$BH_RESET"
    if ((BH_TERM_ROWS == 0 || BH_TERM_ROWS >= 28)); then
        printf '\n'
    fi
}

confirm() {
    local prompt="$1"
    local answer=""
    read -r -p "$prompt [y/N]: " answer || return 1
    [[ "$answer" == "y" || "$answer" == "Y" ]]
}

confirm_twice() {
    local prompt="$1" answer=""
    confirm "$prompt" || return 1
    read -r -p "Type YES to confirm: " answer || return 1
    [[ "$answer" == "YES" ]]
}

human_bytes() {
    local value="${1:-0}"
    [[ "$value" =~ ^[0-9]+$ ]] || value=0
    awk -v bytes="$value" 'BEGIN {
        split("B KiB MiB GiB TiB", unit, " "); i=1
        while (bytes >= 1024 && i < 5) { bytes /= 1024; i++ }
        printf (i == 1 ? "%.0f %s" : "%.1f %s"), bytes, unit[i]
    }'
}

show_file_paged() {
    local title="$1" file="$2"
    local total page=0 page_size start end choice=""
    total="$(wc -l <"$file")"
    [[ "$total" =~ ^[0-9]+$ ]] || total=0
    page_size=$(( $(terminal_row_count) - 6 ))
    ((page_size >= 5)) || page_size=5

    if ! is_terminal || ((total <= page_size)); then
        cat -- "$file"
        pause_menu || true
        return 0
    fi

    while true; do
        clear_screen
        start=$((page * page_size + 1))
        end=$((start + page_size - 1))
        ((end <= total)) || end="$total"
        printf '%s%s%s  [%d-%d / %d]\n\n' \
            "$BH_CYAN" "$title" "$BH_RESET" "$start" "$end" "$total"
        sed -n "${start},${end}p" "$file"
        printf '\n'
        menu_select choice "Page" \
            "1|Next page" "2|Previous page" "0|Back" || return 0
        case "$choice" in
            1) ((end < total)) && page=$((page + 1)) ;;
            2) ((page > 0)) && page=$((page - 1)) ;;
            0) return 0 ;;
        esac
    done
}

capture_and_page() {
    local title="$1"
    shift
    local output status=0
    output="$(mktemp)"
    "$@" >"$output" 2>&1 || status=$?
    show_file_paged "$title" "$output"
    rm -f -- "$output"
    return "$status"
}

systemd_property() {
    local unit="$1" property="$2"
    if [[ "${BH_NO_SYSTEMD:-0}" == "1" ]]; then
        printf 'test-mode\n'
    else
        systemctl show "$unit" --property "$property" --value 2>/dev/null |
            awk 'NF { print; exit }'
    fi
}

service_uptime() {
    local unit="$1" entered now seconds days hours minutes
    entered="$(systemd_property "$unit" ActiveEnterTimestampMonotonic)"
    if [[ ! "$entered" =~ ^[0-9]+$ ]] || ((entered == 0)); then
        printf 'unknown\n'
        return 0
    fi
    now="$(awk '{printf "%.0f", $1*1000000}' /proc/uptime 2>/dev/null || true)"
    [[ "$now" =~ ^[0-9]+$ ]] || { printf 'unknown\n'; return 0; }
    seconds=$(( (now - entered) / 1000000 ))
    ((seconds >= 0)) || seconds=0
    days=$((seconds / 86400)); hours=$((seconds % 86400 / 3600))
    minutes=$((seconds % 3600 / 60)); seconds=$((seconds % 60))
    printf '%dd %02dh %02dm %02ds\n' "$days" "$hours" "$minutes" "$seconds"
}

config_endpoint() {
    local unit="$1" config role endpoint=""
    config="$(unit_config_path "$unit" 2>/dev/null || true)"
    role="$(unit_role_from_config "$config")"
    [[ -r "$config" ]] || { printf 'unknown\n'; return; }
    if [[ "$role" == "client" ]]; then
        endpoint="$(sed -nE 's/^[[:space:]]*remote_addr[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$config" | head -n1)"
    else
        endpoint="$(sed -nE 's/^[[:space:]]*bind_addr[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$config" | head -n1)"
    fi
    printf '%s\n' "${endpoint:-unknown}"
}

active_connection_count() {
    local pid="$1"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || { printf '0\n'; return; }
    if command -v ss >/dev/null 2>&1; then
        ss -Hntp 2>/dev/null | grep -F "pid=$pid," | wc -l
    else
        printf 'unknown\n'
    fi
}

show_compact_status() {
    local unit="$1" current startup pid uptime cpu ram endpoint connections
    current="$(systemctl_state is-active "$unit")"
    startup="$(systemctl_state is-enabled "$unit")"
    pid="$(systemd_property "$unit" MainPID)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || pid=0
    uptime="$(service_uptime "$unit")"
    cpu="$(ps -p "$pid" -o %cpu= 2>/dev/null | awk '{$1=$1; print}' || true)"
    ram="$(ps -p "$pid" -o rss= 2>/dev/null | awk '{printf "%.1f MiB", $1/1024}' || true)"
    endpoint="$(config_endpoint "$unit")"
    connections="$(active_connection_count "$pid")"
    printf 'Service: %s\n' "$unit"
    printf 'Current: %s\n' "${current:-unknown}"
    printf 'Boot: %s\n' "${startup:-unknown}"
    printf 'Uptime: %s\n' "${uptime:-unknown}"
    printf 'PID: %s\n' "$pid"
    printf 'RAM: %s\n' "${ram:-0 MiB}"
    printf 'CPU: %s%%\n' "${cpu:-0.0}"
    printf 'Endpoint: %s\n' "$endpoint"
    printf 'Active connections: %s\n' "$connections"
}

select_unit() {
    local prompt="${1:-Select a Backhaul service}"
    local -a units=()
    local -a choices=()
    local unit current choice index
    mapfile -t units < <(discover_backhaul_units)
    ((${#units[@]} > 0)) || {
        warn "No Backhaul service was found."
        return 1
    }

    if ((${#units[@]} == 1)); then
        printf '%s\n' "${units[0]}"
        return 0
    fi

    for index in "${!units[@]}"; do
        unit="${units[$index]}"
        current="$(systemctl_state is-active "$unit")"
        choices+=("$((index + 1))|$unit [${current:-unknown}]")
    done
    menu_select choice "$prompt" "${choices[@]}" || return 1
    [[ "$choice" =~ ^[0-9]+$ ]] || {
        warn "Invalid selection."
        return 1
    }
    ((choice >= 1 && choice <= ${#units[@]})) || {
        warn "The selected number is outside the list."
        return 1
    }
    printf '%s\n' "${units[$((choice - 1))]}"
}

show_dashboard() {
    printf '=== Tunnel status ===\n'
    "$BH_MANAGER_BIN" list
    printf '\n=== Automatic health-check status ===\n'
    "$BH_MANAGER_BIN" cron status
}

follow_service_logs() {
    local unit="$1"
    # Keep the menu alive when Ctrl+C stops journalctl. Child processes reset
    # caught traps to their default behavior, so journalctl still terminates.
    trap ':' INT
    if command -v python3 >/dev/null 2>&1; then
        journalctl -u "$unit" -n 20 -f -o json 2>/dev/null |
            python3 -u -c '
import datetime, json, sys
levels={0:"EMERG",1:"ALERT",2:"CRIT",3:"ERROR",4:"WARN",5:"NOTICE",6:"INFO",7:"DEBUG"}
for raw in sys.stdin:
    try:
        item=json.loads(raw)
        stamp=int(item.get("__REALTIME_TIMESTAMP", "0"))/1_000_000
        when=datetime.datetime.fromtimestamp(stamp).astimezone().isoformat(timespec="seconds")
        level=levels.get(int(item.get("PRIORITY", 6)), "INFO")
        message=str(item.get("MESSAGE", "")).replace("\n", " ")
        print(f"{when} [{level}] {message}", flush=True)
    except Exception:
        text=raw.strip()
        if text:
            print(text, flush=True)
' || true
    else
        journalctl -u "$unit" -n 20 -f -o short-iso-precise || true
    fi
    trap - INT
    clear_screen
}

mapping_menu() {
    local unit="$1"
    local config role choice="" mapping="" public_port=""
    config="$(unit_config_path "$unit" 2>/dev/null || true)"
    role="$(unit_role_from_config "$config")"
    if [[ "$role" != "server" ]]; then
        warn "This tunnel is a Client and has no local Port Mapping table."
        printf 'Mappings are defined on the matching Server and forward public ports\n'
        printf 'to local services such as 8200=127.0.0.1:8090.\n'
        pause_menu || true
        return 0
    fi

    clear_screen
    printf '%sPort mappings: %s%s\n\n' "$BH_CYAN" "$unit" "$BH_RESET"
    menu_select choice "Selection" \
        "1|Show mappings" \
        "2|Add a mapping" \
        "3|Remove a mapping" \
        "0|Back" || return 0
    case "$choice" in
        1) "$BH_MANAGER_BIN" mapping list "$unit"; pause_menu || true ;;
        2)
            read -r -p "New mapping (example: 8203=127.0.0.1:8093): " mapping ||
                return 0
            confirm "Add mapping $mapping and restart the service?" &&
                "$BH_MANAGER_BIN" mapping add "$unit" "$mapping"
            pause_menu || true
            ;;
        3)
            "$BH_MANAGER_BIN" mapping list "$unit"
            read -r -p "Public port to remove: " public_port || return 0
            confirm "Remove public port $public_port and restart the service?" &&
                "$BH_MANAGER_BIN" mapping remove "$unit" "$public_port"
            pause_menu || true
            ;;
        0) return 0 ;;
        *) warn "Invalid selection."; pause_menu || true ;;
    esac
}

tunnel_management() {
    local unit choice=""
    unit="$(select_unit "Select a tunnel to manage")" || {
        pause_menu || true
        return 0
    }
    while true; do
        clear_screen
        printf '%sTunnel management: %s%s\n\n' "$BH_CYAN" "$unit" "$BH_RESET"
        printf 'Service: %s\n' "$(systemctl_state is-active "$unit")"
        printf 'Boot: %s\n\n' "$(systemctl_state is-enabled "$unit")"
        menu_select choice "Selection" \
            "1|Show mobile status summary" \
            "2|Show live logs" \
            "3|Restart" \
            "4|Start, stop, and boot settings" \
            "5|Manage port mappings" \
            "6|Show config with token redacted" \
            "7|Move tunnel to a recoverable archive" \
            "8|Show full systemd details" \
            "9|Port Monitor" \
            "0|Back" || return 0
        case "$choice" in
            1) show_compact_status "$unit"; pause_menu ;;
            2)
                printf 'Last 20 lines are shown once; then only new logs are followed.\n'
                printf 'Press Ctrl+C to return directly to Tunnel management.\n\n'
                follow_service_logs "$unit"
                ;;
            3)
                confirm_twice "Restart service $unit?" &&
                    "$BH_MANAGER_BIN" restart "$unit"
                pause_menu
                ;;
            4) service_controls_for_unit "$unit" ;;
            5) mapping_menu "$unit" ;;
            6)
                show_redacted_config "$unit"
                pause_menu
                ;;
            7)
                if confirm_twice "Stop this tunnel and move it to a recoverable archive?"; then
                    "$BH_MANAGER_BIN" retire "$unit" --yes
                    pause_menu
                    return 0
                fi
                ;;
            8) capture_and_page "Full service details" systemctl --no-pager --full status "$unit" || true ;;
            9) port_monitor "$unit" ;;
            0) return 0 ;;
            *) warn "Invalid selection."; pause_menu ;;
        esac
    done
}

service_controls_for_unit() {
    local unit="$1"
    local action=""
    clear_screen
    printf '%sService controls: %s%s\n\n' "$BH_CYAN" "$unit" "$BH_RESET"
    menu_select action "Selection" \
        "1|Start" \
        "2|Stop" \
        "3|Restart" \
        "4|Enable at boot" \
        "5|Disable at boot" \
        "0|Back" || return 0
    case "$action" in
        1)
            systemctl start "$unit"
            systemctl is-active "$unit"
            pause_menu || true
            ;;
        2)
            confirm_twice "Stopping $unit will interrupt its tunnel. Continue?" || return 0
            systemctl stop "$unit"
            systemctl is-active "$unit" || true
            pause_menu || true
            ;;
        3)
            confirm_twice "Restart $unit now?" || return 0
            systemctl restart "$unit"
            systemctl is-active "$unit"
            pause_menu || true
            ;;
        4)
            systemctl enable "$unit"
            systemctl is-enabled "$unit"
            pause_menu || true
            ;;
        5)
            confirm_twice "Disable automatic startup for $unit after reboot?" || return 0
            systemctl disable "$unit"
            systemctl is-enabled "$unit" || true
            pause_menu || true
            ;;
        0) return 0 ;;
        *) warn "Invalid selection."; pause_menu || true ;;
    esac
}

show_redacted_config() {
    local unit="$1"
    local config
    config="$(unit_config_path "$unit" 2>/dev/null || true)"
    [[ -n "$config" && -r "$config" ]] || {
        warn "The service config was not found."
        return 0
    }
    sed -E \
        's/^([[:space:]]*[A-Za-z0-9_]*token[[:space:]]*=[[:space:]]*).*/\1"***REDACTED***"/' \
        "$config"
}

